# Copy to .env. Never expose this file through GitHub Pages or commit API keys.
PORT=8787
NODE_ENV=production
TRUST_PROXY=1

# LLM configuration (same naming used by Neyobytes WhatsApp Agent)
LLM_PROVIDER=chatgpt
LLM_MODEL=gpt-5.6-terra
CHATGPT_BASE_URL=https://gateway.neyobytes.com/v1
CHATGPT_REASONING_EFFORT=high

# Choose one credential strategy:
# 1) Leave CHATGPT_API_KEY blank and run `codex login` on the server.
# 2) Set a gateway API key here.
CHATGPT_API_KEY=
CODEX_AUTH_PATH=~/.codex/auth.json

# Public endpoint safeguards
LLM_MAX_OUTPUT_TOKENS=700
LLM_TIMEOUT_MS=30000
RATE_LIMIT_WINDOW_MS=300000
RATE_LIMIT_MAX=10
ALLOWED_ORIGINS=https://hazrid93.github.io,http://localhost:8787,http://127.0.0.1:8787